{
	"name": "skeleton",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@pondorasti/remark-img-links": "^1.0.8",
		"@shikijs/rehype": "^4.6.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/ui": "^4.1.12",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"gh-pages": "^6.3.0",
		"globals": "^17.14.0",
		"jsdom": "^30.1.3",
		"mdsvex": "^0.12.8",
		"mdsvex-relative-images": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remark": "^15.0.1",
		"remark-html": "^16.0.1",
		"remark-link-rewrite": "^1.0.7",
		"svelte": "^5.57.3",
		"svelte-adapter-ghpages": "^0.2.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"carta-md": "^4.11.5",
		"dotenv": "^18.0.9",
		"flowbite-svelte": "^1.33.1",
		"lodash-es": "^4.18.1",
		"open-graph-scraper": "^6.13.0",
		"shiki": "^4.6.0"
	}
